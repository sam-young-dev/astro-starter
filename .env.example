# Public URL of the deployed site. Used for canonical URLs and social tags.
SITE_URL=https://example.com

# Keystatic: set to "owner/repo" to save edits to GitHub instead of local files.
# Must be set at build time (in Netlify's environment variables for production).
# PUBLIC_KEYSTATIC_GITHUB_REPO=owner/repo

# Keystatic GitHub App credentials. `astro dev` with the repo set above walks
# you through creating the app and writes these to .env. Copy them to Netlify.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
