---
import { siteData } from "../../data/site-data";
import { isCurrentPath } from "../../utils/nav";

const year = new Date().getFullYear();
const { pathname } = Astro.url;
---

<footer class="site-foot">
  <div class="wrapper">
    <div class="repel site-foot__top">
      <nav aria-label="Footer" class="nav">
        <ul class="cluster" role="list">
          {siteData.navItems.map((item) => (
            <li>
              <a
                href={item.href}
                {...(isCurrentPath(pathname, item.href)
                  ? { "aria-current": "page" }
                  : {})}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <!-- Hidden until the script below enhances it, since it needs JS to work -->
      <button
        class="site-foot__theme"
        type="button"
        data-theme-toggle
        hidden
      >
        <span class="visually-hidden" data-theme-label>
          Switch to dark mode
        </span>
        <svg
          class="site-foot__icon site-foot__icon--sun"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg
          class="site-foot__icon site-foot__icon--moon"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
    <div class="repel">
      <p>
        &copy; {siteData.title} {year}
      </p>
      <p>All rights reserved.</p>
    </div>
  </div>
</footer>

<script>
  import { getMode, setStoredMode } from "../../scripts/theme";

  const themeToggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const themeLabel =
    themeToggle?.querySelector<HTMLElement>("[data-theme-label]");

  if (themeToggle && themeLabel) {
    themeToggle.hidden = false;

    // The label names the action, and the icon shows the mode the click switches to.
    const sync = () => {
      themeLabel.textContent = `Switch to ${getMode() === "dark" ? "light" : "dark"} mode`;
    };

    themeToggle.addEventListener("click", () => {
      setStoredMode(getMode() === "dark" ? "light" : "dark");
      sync();
    });

    // Keep the label right when the OS scheme changes and no choice has been stored.
    document.documentElement.addEventListener("themechange", sync);
    sync();
  }
</script>
