---
import { siteData } from "../../data/site-data";
import { isCurrentPath } from "../../utils/nav";

const { pathname } = Astro.url;
---

<header class="site-head" data-site-head>
  <div class="wrapper">
    <div class="repel site-head__inner">
      <div class="site-head__brand">
        <a href="/">{siteData.title}</a>
      </div>
      <!-- The buttons stay hidden until the script below enhances the header, so the nav works without JS -->
      <button
        class="site-head__button site-head__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        hidden
      >
        <span class="visually-hidden">Menu</span>
        <svg class="site-head__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
      <nav id="primary-nav" aria-label="Primary" class="nav site-head__nav">
        <ul class="cluster" role="list">
          {siteData.navItems.map((item) => (
            <li>
              <a
                href={item.href}
                {...(isCurrentPath(pathname, item.href)
                  ? { "aria-current": "page" }
                  : {})}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <button
        class="site-head__button site-head__theme"
        type="button"
        data-theme-toggle
        hidden
      >
        <span class="visually-hidden" data-theme-label>
          Switch to dark mode
        </span>
        <svg
          class="site-head__icon site-head__icon--sun"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg
          class="site-head__icon site-head__icon--moon"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  import { getMode, setStoredMode } from "../../scripts/theme";

  const header = document.querySelector<HTMLElement>("[data-site-head]");
  const toggle = header?.querySelector<HTMLButtonElement>(".site-head__toggle");
  const themeToggle = header?.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const themeLabel =
    themeToggle?.querySelector<HTMLElement>("[data-theme-label]");

  if (header && toggle) {
    toggle.hidden = false;
    header.dataset.navJs = "";

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      header.toggleAttribute("data-nav-open", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    header.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });
  }

  if (themeToggle && themeLabel) {
    themeToggle.hidden = false;

    // The label names the action, and the icon shows the mode the click switches to.
    const sync = () => {
      themeLabel.textContent = `Switch to ${getMode() === "dark" ? "light" : "dark"} mode`;
    };

    themeToggle.addEventListener("click", () => {
      setStoredMode(getMode() === "dark" ? "light" : "dark");
      sync();
    });

    // Keep the label right when the OS scheme changes and no choice has been stored.
    document.documentElement.addEventListener("themechange", sync);
    sync();
  }
</script>
