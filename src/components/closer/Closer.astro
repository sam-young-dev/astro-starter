---
import { siteData } from "../../data/site-data";
import { isCurrentPath } from "../../utils/nav";

const { pathname } = Astro.url;
---

<div class="closer">
  <div class="wrapper flow">
    <slot />
    {siteData.navItems.length > 0 && (
      <nav aria-label="Footer" class="nav">
        <ul class="cluster" role="list">
          {siteData.navItems.map((item) => (
            <li>
              <a href={item.href} {...(isCurrentPath(pathname, item.href) ? { "aria-current": "page" } : {})}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</div>
