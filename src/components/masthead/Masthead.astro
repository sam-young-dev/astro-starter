---
interface Props {
  heading: string;
  location?: string;
  meta?: string;
}

const { heading, location, meta } = Astro.props;
---

<div class="masthead">
  <h1 class="masthead__heading">{heading}</h1>
  {location && <p class="masthead__location">{location}</p>}
  {meta && <p class="masthead__meta">{meta}</p>}
</div>
