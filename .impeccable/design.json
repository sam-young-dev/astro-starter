  "narrative": {
    "northStar": "The Blank Letterhead",
    "overview": "This is the stationery a client’s brand gets printed onto. The page is a warm stone paper with near-black ink, one saturated cobalt, and Archivo doing most of the work. Nothing is decorated and nothing is branded, because every visual decision exists to be overwritten by changing tokens.",
    "keyCharacteristics": [
      "Stone paper and near-black ink, with a single cobalt accent used sparingly.",
      "Fluid type and spacing scales; nothing is a fixed pixel step.",
      "Flat surfaces with hairline strokes; depth comes from tone, not shadow.",
      "Square, uppercase, bold buttons and navigation.",
      "Every value is a token; brand swaps happen in src/design-tokens/."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Cobalt appears on a few large blocks and primary actions, never as scattered decoration.",
        "section": "colors"
      },
      {
        "name": "The Token Only Rule",
        "body": "No raw colour values in components. Colours come from the semantic tokens.",
        "section": "colors"
      },
      {
        "name": "The Rebrand Rule",
        "body": "To rebrand, change brand-primary and the neutral ladder in colors.json. Components must not need editing.",
        "section": "colors"
      },
      {
        "name": "The Measure Rule",
        "body": "Prose never exceeds 70ch and headings never exceed 35ch.",
        "section": "typography"
      },
      {
        "name": "The Uppercase Label Rule",
        "body": "Only controls and navigation are uppercase.",
        "section": "typography"
      },
      {
        "name": "The Flat Until Floating Rule",
        "body": "Only an element that genuinely floats above the page may take a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do take every colour, size, space and radius from the Sugarcube tokens.",
      "Do structure CSS in CUBE layers.",
      "Do keep the navigation and core content working with JavaScript disabled.",
      "Do verify contrast in both light and dark mode against WCAG 2.2 AA.",
      "Do use Focus Pink at 2px for focus, and keep it visible on every surface including cobalt."
    ],
    "donts": [
      "Don’t write raw hex, rgb or oklch values in component CSS.",
      "Don’t put shadows on cards or static blocks.",
      "Don’t add rounded corners to buttons or bands.",
      "Don’t let body text exceed 70ch or use uppercase for anything but labels and navigation.",
      "Don’t hard-code the brand outside the tokens and src/fonts.",
      "Don’t use Quieter Ink for essential copy."
    ]
  }
}